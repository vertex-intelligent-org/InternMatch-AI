# InternMatch AI — Mobile Application Environment Template (Expo)
# DO NOT put real secrets in this file.
# Copy this file to .env for local development.
# NOTE: All EXPO_PUBLIC_* variables are bundled into the client app and are publicly readable.

# Public Supabase Project Endpoint
EXPO_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co

# Public Supabase Client Publishable / Anon Key (Safe for client-side inclusion)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_placeholder_key

# Backend API Endpoint Base URL (Must include /api/v1 prefix)
# - Android Emulator (access host machine): http://10.0.2.2:8000/api/v1
# - iOS Simulator / Web: http://localhost:8000/api/v1
# - Physical Android/iOS Device on same Wi-Fi: http://<YOUR_LAN_IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# RevenueCat public SDK key.
# For the Shipaton development/Test Store workflow, use the
# RevenueCat Test Store public SDK key from Project Settings > API keys.
# Never place a RevenueCat secret/server API key in this mobile file.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Production RevenueCat public SDK keys. Set through the release build environment.
# Never place a RevenueCat Test Store key in either production variable.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
