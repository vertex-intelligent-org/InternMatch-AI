# Server-only settings. Never put service_role / sb_secret keys in this app.
WEB_AUTH_ENABLED=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
INTERNMATCH_API_URL=https://api.internmatch.college/api/v1
WEB_ORIGIN=http://127.0.0.1:3100
WEB_FLOW_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Enable only after the callback URL is allowed and checked in Supabase Auth.
WEB_EMAIL_FLOWS_ENABLED=0
WEB_GOOGLE_ENABLED=0
# Apple web auth is intentionally unavailable pending its separate integration.
