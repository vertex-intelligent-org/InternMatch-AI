# InternMatch AI — Master Environment Configuration Template
# DO NOT put actual production secrets in this file!
# Copy this file to .env for local development.

# Application Runtimes & Ports
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Supabase Configuration & Credentials (SERVER-ONLY SECRETS)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub_placeholder_key_for_client_side
SUPABASE_SERVICE_ROLE_KEY=sb_serv_placeholder_key_server_only
SUPABASE_JWT_SECRET=placeholder_jwt_secret_for_local_development
DATABASE_URL=postgresql://postgres:placeholder_password@placeholder_project.supabase.co:5432/postgres
CV_STORAGE_BUCKET=cvs
AVATAR_STORAGE_BUCKET=avatars

# Redis Task Queue & Worker URL
# - When running with Docker Compose: redis://redis:6379/0
# - When running natively on host: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Pinned AI Models & Matching Configuration (SERVER-ONLY SECRETS)
GEMINI_API_KEY=gemini_placeholder_key_server_only
LLM_MODEL_NAME=gemini-3.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=1536
SKILL_FUZZY_THRESHOLD=85

# Optional/reserved server-side RevenueCat credential (SERVER-ONLY SECRET).
# Not required for the current mobile RevenueCat Test Store flow.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Security & CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:19006
